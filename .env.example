# Local application secrets. Copy to .env for Docker Compose, then replace every value.
MYSQL_USER=tapeverify
MYSQL_PASSWORD=replace-with-a-local-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password
JWT_SECRET=replace-with-a-base64-encoded-secret-of-at-least-32-bytes
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
# Optional: enables OpenAI-backed explanations when SPRING_PROFILES_ACTIVE=ai.
OPENAI_API_KEY=
# Used at frontend build time for Docker. Leave local unless deploying separately.
VITE_API_BASE_URL=http://localhost:8080/api/v1
